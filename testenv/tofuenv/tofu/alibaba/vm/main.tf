# ---------------------------------------------------------------------------
# Alibaba ECS VM used as the filesystem migration test target.
#   The VPC, vSwitch and server security group created by the network module are
#   looked up by name. The public IP comes with the instance itself
#   (internet_max_bandwidth_out > 0), so no EIP is needed.
# ---------------------------------------------------------------------------
# The key file carries the prefix: each prefix is an environment of its own (a tofu
# workspace), and a fixed name would let the next one overwrite this VM's key.
locals {
  key_name           = "${var.alibaba_name_prefix}-vm"
  server_name        = "${var.alibaba_name_prefix}-vm"
  key_file_name      = "alibaba-${var.alibaba_name_prefix}-vm.pem"
  container_key_path = "${var.ssh_key_dir}/${local.key_file_name}"
  host_key_path      = "ssh_keys/${local.key_file_name}" # Relative to the host-side tofuenv directory.
  ssh_user           = "root"                            # Alibaba-provided images log in as root.
}

# --- Look up what the network module created -------------------------------
data "alicloud_vpcs" "this" {
  name_regex = "^${var.alibaba_name_prefix}-vpc$"
}

data "alicloud_vswitches" "this" {
  vpc_id     = local.vpc_id
  name_regex = "^${var.alibaba_name_prefix}-vswitch$"
}

data "alicloud_security_groups" "server" {
  vpc_id     = local.vpc_id
  name_regex = "^${var.alibaba_name_prefix}-server-sg$"
}

# --- System image ----------------------------------------------------------
data "alicloud_images" "this" {
  name_regex  = var.alibaba_image_name_regex
  owners      = "system"
  os_type     = "linux"
  most_recent = true
}

locals {
  vpc_id     = data.alicloud_vpcs.this.vpcs[0].id
  vswitch_id = data.alicloud_vswitches.this.vswitches[0].id
  sg_id      = data.alicloud_security_groups.server.groups[0].id
  image_id   = try(data.alicloud_images.this.images[0].id, null)
  image_size = try(data.alicloud_images.this.images[0].size, 0)
}

# --- SSH key pair (generated by tofu) --------------------------------------
# Alibaba writes the key pair into root's authorized_keys, so the same key is
# used for SSH and for gendata's SFTP.
resource "tls_private_key" "vm" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "alicloud_ecs_key_pair" "vm" {
  key_pair_name = local.key_name
  public_key    = tls_private_key.vm.public_key_openssh
}

resource "local_sensitive_file" "vm_key" {
  content         = tls_private_key.vm.private_key_pem
  filename        = local.container_key_path
  file_permission = "0600"
}

# --- Instance ---------------------------------------------------------------
resource "alicloud_instance" "vm" {
  instance_name        = local.server_name
  host_name            = local.server_name
  description          = "cm-centipede filesystem migration test VM"
  image_id             = local.image_id
  instance_type        = var.alibaba_instance_type
  instance_charge_type = "PostPaid"
  vswitch_id           = local.vswitch_id
  security_groups      = [local.sg_id]
  key_name             = alicloud_ecs_key_pair.vm.key_pair_name

  system_disk_category = var.alibaba_vm_disk_category
  system_disk_size     = var.alibaba_vm_volume_size

  internet_charge_type       = "PayByTraffic"
  internet_max_bandwidth_out = var.alibaba_vm_bandwidth_out

  user_data = base64encode(templatefile("${path.module}/templates/vm-init.sh.tpl", {
    data_path = var.alibaba_data_path
  }))

  lifecycle {
    precondition {
      condition     = local.image_id != null
      error_message = "No system image matches TF_VAR_alibaba_image_name_regex='${var.alibaba_image_name_regex}'. Run ./scripts/alibaba-db-versions.sh server to list the available image names."
    }
    # Alibaba refuses a system disk smaller than the image
    # (InvalidSystemDiskSize.LessThanImageSize); caught here at plan time instead.
    precondition {
      condition     = local.image_size <= var.alibaba_vm_volume_size
      error_message = "The image TF_VAR_alibaba_image_name_regex='${var.alibaba_image_name_regex}' picks (${coalesce(local.image_id, "-")}) is ${local.image_size} GB, more than TF_VAR_alibaba_vm_volume_size=${var.alibaba_vm_volume_size}. Narrow the regex to a smaller image (./scripts/alibaba-db-versions.sh server) or raise the volume size."
    }
  }
}
