# ---------------------------------------------------------------------------
# GCP Compute Engine VM used as the filesystem migration test target.
#   The VPC, subnet, SSH firewall rule and static external IP the VM needs are
#   created here: as on Azure there is no separate network module, since
#   nothing else uses the VPC - the Cloud SQL instances are reached over their
#   public IPs.
#   The login is ubuntu with the generated key, put on the VM through instance
#   metadata (ssh-keys). That needs OS Login off for the VM: it is switched off
#   on the instance, which works unless an organization policy enforces OS Login.
# ---------------------------------------------------------------------------
# The key file carries the prefix: each prefix is an environment of its own (a tofu
# workspace), and a fixed name would let the next one overwrite this VM's key.
locals {
  server_name        = "${var.gcp_name_prefix}-vm"
  key_file_name      = "gcp-${var.gcp_name_prefix}-vm.pem"
  container_key_path = "${var.ssh_key_dir}/${local.key_file_name}"
  host_key_path      = "ssh_keys/${local.key_file_name}" # Relative to the host-side tofuenv directory.
  ssh_user           = "ubuntu"
}

# --- Network --------------------------------------------------------------
# A GCP VPC is global and has no address range of its own; the range is the
# subnet's, which is regional.
resource "google_compute_network" "this" {
  name                    = "${var.gcp_name_prefix}-vpc"
  auto_create_subnetworks = false
}

resource "google_compute_subnetwork" "this" {
  name          = "${var.gcp_name_prefix}-subnet"
  region        = var.gcp_region
  network       = google_compute_network.this.id
  ip_cidr_range = var.gcp_subnet_cidr
}

# Egress is allowed by the VPC's implied rule, so only SSH ingress is declared,
# and only to this VM (by its network tag).
resource "google_compute_firewall" "ssh" {
  name          = "${var.gcp_name_prefix}-vm-ssh"
  network       = google_compute_network.this.id
  direction     = "INGRESS"
  source_ranges = [var.allowed_cidr]
  target_tags   = [local.server_name]

  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

# Static, so the address gendata and the ssh command use survives a stop / start.
resource "google_compute_address" "this" {
  name         = "${var.gcp_name_prefix}-vm-ip"
  region       = var.gcp_region
  address_type = "EXTERNAL"
}

# --- SSH key (generated by tofu) ------------------------------------------
resource "tls_private_key" "vm" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "local_sensitive_file" "vm_key" {
  content         = tls_private_key.vm.private_key_pem
  filename        = local.container_key_path
  file_permission = "0600"
}

# --- VM ---------------------------------------------------------------------
data "google_compute_image" "ubuntu" {
  project = var.gcp_image_project
  family  = var.gcp_image_family
}

resource "google_compute_instance" "vm" {
  name         = local.server_name
  zone         = var.gcp_zone
  machine_type = var.gcp_machine_type
  tags         = [local.server_name]

  # A machine type change needs the VM stopped; let tofu do it.
  allow_stopping_for_update = true

  boot_disk {
    auto_delete = true
    initialize_params {
      image = data.google_compute_image.ubuntu.self_link
      size  = var.gcp_vm_volume_size
      type  = var.gcp_vm_disk_type
    }
  }

  network_interface {
    subnetwork = google_compute_subnetwork.this.id
    access_config {
      nat_ip = google_compute_address.this.address
    }
  }

  metadata = {
    ssh-keys               = "${local.ssh_user}:${trimspace(tls_private_key.vm.public_key_openssh)}"
    block-project-ssh-keys = "true"
    enable-oslogin         = "FALSE"
  }

  metadata_startup_script = templatefile("${path.module}/templates/vm-init.sh.tpl", {
    data_path = var.gcp_data_path
    ssh_user  = local.ssh_user
  })

  lifecycle {
    precondition {
      condition     = startswith(var.gcp_zone, "${var.gcp_region}-")
      error_message = "TF_VAR_gcp_zone (${var.gcp_zone}) is not in TF_VAR_gcp_region (${var.gcp_region}); pick a zone of that region, e.g. ${var.gcp_region}-a."
    }
  }

  # SSH must be open by the time the VM is reported ready.
  depends_on = [google_compute_firewall.ssh]
}
