# ---------------------------------------------------------------------------
# Azure Linux VM used as the filesystem migration test target.
#   Everything lives in a resource group of its own, <prefix>-vm-rg, together
#   with the VNet, subnet, NSG, public IP and NIC the VM needs: unlike NCP and
#   Alibaba there is no separate network module, since nothing else uses the
#   VNet - the databases are reached over their public endpoints.
#   Azure does not allow root as the admin account, so the login is azureuser.
# ---------------------------------------------------------------------------
# The key file carries the prefix: each prefix is an environment of its own (a tofu
# workspace), and a fixed name would let the next one overwrite this VM's key.
locals {
  rg_name            = "${var.azure_name_prefix}-vm-rg"
  server_name        = "${var.azure_name_prefix}-vm"
  key_file_name      = "azure-${var.azure_name_prefix}-vm.pem"
  container_key_path = "${var.ssh_key_dir}/${local.key_file_name}"
  host_key_path      = "ssh_keys/${local.key_file_name}" # Relative to the host-side tofuenv directory.
  ssh_user           = "azureuser"
}

resource "azurerm_resource_group" "this" {
  name     = local.rg_name
  location = var.azure_region
}

# --- Network --------------------------------------------------------------
resource "azurerm_virtual_network" "this" {
  name                = "${var.azure_name_prefix}-vnet"
  resource_group_name = azurerm_resource_group.this.name
  location            = azurerm_resource_group.this.location
  address_space       = [var.azure_vnet_cidr]
}

resource "azurerm_subnet" "this" {
  name                 = "${var.azure_name_prefix}-subnet"
  resource_group_name  = azurerm_resource_group.this.name
  virtual_network_name = azurerm_virtual_network.this.name
  address_prefixes     = [cidrsubnet(var.azure_vnet_cidr, 8, 1)] # e.g. 10.30.0.0/16 -> 10.30.1.0/24
}

# Outbound is open by default on an Azure NSG, so only SSH inbound is declared.
resource "azurerm_network_security_group" "this" {
  name                = "${var.azure_name_prefix}-vm-nsg"
  resource_group_name = azurerm_resource_group.this.name
  location            = azurerm_resource_group.this.location

  security_rule {
    name                       = "ssh"
    description                = "SSH"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = var.allowed_cidr == "0.0.0.0/0" ? "*" : var.allowed_cidr
    destination_address_prefix = "*"
  }
}

# Standard SKU: Basic public IPs are retired, and Standard requires Static.
resource "azurerm_public_ip" "this" {
  name                = "${var.azure_name_prefix}-vm-pip"
  resource_group_name = azurerm_resource_group.this.name
  location            = azurerm_resource_group.this.location
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "this" {
  name                = "${var.azure_name_prefix}-vm-nic"
  resource_group_name = azurerm_resource_group.this.name
  location            = azurerm_resource_group.this.location

  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.this.id
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = azurerm_public_ip.this.id
  }
}

resource "azurerm_network_interface_security_group_association" "this" {
  network_interface_id      = azurerm_network_interface.this.id
  network_security_group_id = azurerm_network_security_group.this.id
}

# --- SSH key (generated by tofu) ------------------------------------------
resource "tls_private_key" "vm" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "local_sensitive_file" "vm_key" {
  content         = tls_private_key.vm.private_key_pem
  filename        = local.container_key_path
  file_permission = "0600"
}

# --- VM ---------------------------------------------------------------------
resource "azurerm_linux_virtual_machine" "vm" {
  name                  = local.server_name
  computer_name         = local.server_name
  resource_group_name   = azurerm_resource_group.this.name
  location              = azurerm_resource_group.this.location
  size                  = var.azure_vm_size
  admin_username        = local.ssh_user
  network_interface_ids = [azurerm_network_interface.this.id]

  disable_password_authentication = true

  admin_ssh_key {
    username   = local.ssh_user
    public_key = tls_private_key.vm.public_key_openssh
  }

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = var.azure_vm_disk_type
    disk_size_gb         = var.azure_vm_volume_size
  }

  source_image_reference {
    publisher = "Canonical"
    offer     = var.azure_image_offer
    sku       = var.azure_image_sku
    version   = "latest"
  }

  custom_data = base64encode(templatefile("${path.module}/templates/vm-init.sh.tpl", {
    data_path = var.azure_data_path
    ssh_user  = local.ssh_user
  }))

  # The NSG has to be on the NIC before the VM boots, or SSH is unreachable
  # until the association lands.
  depends_on = [azurerm_network_interface_security_group_association.this]
}
