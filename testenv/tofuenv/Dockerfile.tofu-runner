# OpenTofu runner (a long-lived container)
#   Ships tofu, the Alibaba Cloud CLI (aliyun), curl, jq, git, openssh-client and bash.
#   scripts/*.sh run their tofu commands in this container through docker exec.
FROM debian:12-slim

# Override the version at build time if needed: --build-arg TOFU_VERSION=1.9.1
ARG TOFU_VERSION=1.9.1
ARG TARGETARCH=amd64
# The Alibaba Cloud CLI, for what the alicloud provider has no data source for:
# scripts/alibaba-db-versions.sh mongodb lists the MongoDB versions and classes
# with it (DescribeAvailableResource). --build-arg ALIYUN_CLI_VERSION=x.y.z
ARG ALIYUN_CLI_VERSION=3.5.2

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl unzip ca-certificates bash jq git openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Install OpenTofu by extracting just the tofu binary from the release zip.
RUN curl -fsSL "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_linux_${TARGETARCH}.zip" -o /tmp/tofu.zip \
    && unzip -o /tmp/tofu.zip tofu -d /usr/local/bin \
    && chmod +x /usr/local/bin/tofu \
    && rm /tmp/tofu.zip \
    && tofu version

# Install the Alibaba Cloud CLI, checked against the release's SHASUMS256.txt.
# It holds no credentials: the scripts hand it the keys from OpenBao as
# ALIBABA_CLOUD_ACCESS_KEY_ID / _SECRET for one call, and nothing is configured.
RUN cd /tmp \
    && curl -fsSLO "https://github.com/aliyun/aliyun-cli/releases/download/v${ALIYUN_CLI_VERSION}/aliyun-cli-linux-${ALIYUN_CLI_VERSION}-${TARGETARCH}.tgz" \
    && curl -fsSLO "https://github.com/aliyun/aliyun-cli/releases/download/v${ALIYUN_CLI_VERSION}/SHASUMS256.txt" \
    && grep " aliyun-cli-linux-${ALIYUN_CLI_VERSION}-${TARGETARCH}.tgz\$" SHASUMS256.txt | sha256sum -c - \
    && tar -xzf "aliyun-cli-linux-${ALIYUN_CLI_VERSION}-${TARGETARCH}.tgz" -C /usr/local/bin aliyun \
    && chmod +x /usr/local/bin/aliyun \
    && rm -f /tmp/aliyun-cli-*.tgz /tmp/SHASUMS256.txt \
    && aliyun version

# Provider plugin cache, reused across modules to speed up init.
ENV TF_PLUGIN_CACHE_DIR=/work/.tofu-plugin-cache

WORKDIR /work
