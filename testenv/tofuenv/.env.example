# ==============================================================================
# Environment variable template for the tofuenv preparation environment
# ------------------------------------------------------------------------------
#   1) Copy this file to .env:  cp .env.example .env && chmod 600 .env
#      Mode 600 is enforced: up.sh and register-creds.sh refuse to read a .env
#      anyone else can. VAULT_TOKEN below is the OpenBao root token and is never
#      blanked, so this file stays sensitive long after the CSP keys are gone.
#   2) Fill in [SHARED] and the section for the CSP you use. Every value shipped
#      as ChangeMe must be changed by you, in every CSP section: leave the
#      [CREDENTIAL] keys of a CSP you do not use empty. Nothing falls back to a
#      default - while any one is still ChangeMe (compared case-insensitively) or
#      missing, up.sh, register-creds.sh and prepare.sh stop before doing
#      anything. A bucket name cannot be empty when that bucket is prepared.
#   3) Run ./scripts/up.sh to start OpenBao, init, unseal and register credentials.
#
#   This file is organised by CSP:
#
#     [SHARED]  OpenBao + inbound network access     always required
#     [AWS]     credentials + settings               skip if you do not use AWS
#     [NCP]     credentials + settings               skip if you do not use NCP
#     [ALIBABA] credentials + settings               skip if you do not use Alibaba
#     [AZURE]   credentials + settings               skip if you do not use Azure
#     [GCP]     credentials + settings               skip if you do not use GCP
#
#   Keys marked [CREDENTIAL] are sensitive. On successful registration,
#   register-creds.sh stores them in OpenBao and then blanks them here, so no
#   plaintext key stays on disk. Everything else is kept as is.
#
#   .env is listed in .gitignore. Never commit it.
# ==============================================================================


# ==============================================================================
# ===
# ===   S H A R E D        required regardless of which CSP you use
# ===
# ==============================================================================

# --- OpenBao ------------------------------------------------------------------
#   VAULT_TOKEN is filled in automatically when openbao-init.sh runs; leave it
#   empty on a fresh setup.
#   VAULT_ADDR is the address used to reach OpenBao FROM THE HOST. Inside
#   containers, docker-compose injects http://openbao:8200 instead.
VAULT_ADDR=http://localhost:38200
VAULT_TOKEN=

# --- Inbound network access ---------------------------------------------------
#   Applies to AWS security groups, NCP ACGs, the Alibaba security group and
#   RDS / MongoDB whitelists, the Azure NSG and DB firewall rules (which take
#   an IP range rather than a CIDR - the module converts it), and the GCP VPC
#   firewall and Cloud SQL authorized networks. Wide open by default
#   for convenience; narrow it to your own address (e.g. 1.2.3.4/32) for real use.
TF_VAR_allowed_cidr=0.0.0.0/0

# --- gendata test data size ---------------------------------------------------
#   How much test data ./scripts/gen-data.sh generates. The same numbers apply to
#   every CSP, which is why they sit here rather than in a CSP section.
#
#   These are NOT TF_VAR_*: OpenTofu never reads them. gendata does - .env is
#   sourced with `set -a`, so gendata inherits them - and they override the
#   defaults in gendata/config/config.json. A flag on the command line wins over
#   both. A key gendata does not recognise is reported when gen-data.sh runs.
#
#   Mind the prepared capacity: the dummy files also have to fit on the VM's
#   volume (TF_VAR_aws_vm_volume_size, 20 GB) and the database size on the
#   instance's storage (AWS 20 GB; Alibaba TF_VAR_alibaba_db_allocated_storage;
#   Azure TF_VAR_azure_*_storage_gb; GCP TF_VAR_gcp_*_storage_gb, with
#   TF_VAR_gcp_vm_volume_size for the VM; NCP Cloud DB storage grows by itself and is
#   not checked). gendata refuses a request over 80% of either, since an instance that fills its disk has to be
#   torn down and prepared again rather than just cleaned up. A data path
#   on the VM's EFS mount is not checked - EFS grows with what is written.

#   Dummy files for the bucket and filesystem targets: the TOTAL in MB, over all
#   eight formats (csv, txt, sql, json, xml, png, gif, zip). It is split 1 MB at a
#   time in that order, so 8 is 1 MB of each and 10 gives csv and txt 2 MB.
#   Leave it unset to use config.json, where every format is 1 MB.
GENDATA_DUMMY_SIZE_MB=8

#   Per-format sizes in MB. The formats named here keep their size, and what is
#   left of GENDATA_DUMMY_SIZE_MB is split over the others; 0 switches a format
#   off. With GENDATA_DUMMY_SIZE_MB=1000 the line below makes zip 100 MB, drops
#   png and gif, and splits the other 900 MB over the five text formats (180 MB
#   each). Naming more than the total is an error.
#GENDATA_DUMMY_SIZES=png=0,gif=0,zip=100

#   The most dummy files to generate; 0 means no limit. Leave it unset to use
#   config.json (layout.maxFiles, 1000). Over the limit the total size is kept
#   and the files grow instead; png and gif stay at 20 MB a file at most, and
#   formats beyond the limit are skipped - see gendata/README.md, "layout".
#GENDATA_DUMMY_MAX_FILES=1000

#   Large files: GENDATA_LARGE_FILES files of GENDATA_LARGE_FILE_MB each, as
#   large/large_<MB>mb_<i>.bin under the bucket prefix and the VM data path -
#   beside the dummy set's dir_* tree, never in it. 0 files, the default, adds
#   none - the size can stay set and the count switches them on.
#   While both are above 0 they are added on every bucket/filesystem run;
#   `./scripts/gen-data.sh --target bucket --large-only` adds just these to a
#   dataset that is already there. Their bytes are streamed, so they need no room
#   in GENDATA_TMP_DIR. --large-file-mb / --large-files override these per run.
GENDATA_LARGE_FILE_MB=10240
GENDATA_LARGE_FILES=0

#   Bulk rows added to each database AFTER the shop_db fixture, in MB.
#   0 - the default - loads the fixture only. The fixture is what carries the
#   tables, views, procedures, triggers and the multibyte rows a migration is
#   judged on; this is volume on top of it, spread over customers, products,
#   orders, order_items, reviews and inventory_log.
#   Expect the loaded size to differ from what is asked for: it is an estimate of
#   rows, and each engine adds its own overhead. gendata reports what actually
#   landed, and runs/last-run.json records it.
GENDATA_DB_SIZE_MB=0

#   Where the dummy files are staged on this machine before they are uploaded or
#   transferred; they are deleted when the run ends. Leave it unset for the system
#   temp directory (/tmp). Point it at a disk with room for the whole dummy total
#   when that is large - under WSL /tmp sits on the root disk. Absolute path; it is
#   created if missing. Not TMPDIR: .env also reaches tofu in the runner container.
#GENDATA_TMP_DIR=/data/gendata-tmp

#   How many at once. Leave them unset for config.json's defaults (in brackets).
#   Raise them when the link to the cloud is the bottleneck, lower them when the
#   machine or the target struggles.
#GENDATA_GEN_WORKERS=0            # dummy files generated at once [0 = one per CPU]
#GENDATA_UPLOAD_CONCURRENCY=32    # bucket: objects uploaded at once [32]
#GENDATA_SFTP_CONCURRENCY=10      # filesystem: files transferred at once [10]
#GENDATA_SFTP_CONNECTIONS=4       # filesystem: SSH connections they share [4]
#GENDATA_DB_WORKERS=4             # database: connections writing bulk rows - MySQL, MariaDB, MongoDB [4]


# ##############################################################################
# ###
# ###   A W S        S3 bucket / RDS (mysql, mariadb, postgres) / EC2 (vm)
# ###
# ##############################################################################

# --- [CREDENTIAL] Access key --------------------------------------------------
#   Stored in OpenBao secret/csp/aws, then blanked here.
#   The IAM user needs S3, RDS and EC2 permissions, plus EFS for the VM's NFS.
AWS_ACCESS_KEY_ID=ChangeMe
AWS_SECRET_ACCESS_KEY=ChangeMe

# --- [CREDENTIAL] DB master password ------------------------------------------
#   Stored in OpenBao secret/db/aws, then blanked here.
AWS_DB_PASSWORD=ChangeMe

# --- Region, sizing and naming ------------------------------------------------
#   name_prefix is short for "centipede tofu" - it names every AWS resource this
#   environment creates (cptf-vm, cptf-mysql, cptf-rds-sg, ...) so they are easy
#   to tell apart from anything else in the account. 2-20 lowercase characters.
#   The bucket is not covered by it, since an S3 name must be globally unique.
#
#   The prefix is also the environment: every module keeps one state per prefix
#   and every script acts on this one only. Changing it starts a NEW environment
#   next to the old one, which keeps running and costing money until you put its
#   prefix back and tear it down. ./scripts/list.sh shows every environment.
#   Each environment needs its own TF_VAR_aws_bucket_name. "default" is reserved.
TF_VAR_aws_region=ap-northeast-2
TF_VAR_aws_name_prefix=cptftemp
TF_VAR_aws_instance_type=t3.micro
TF_VAR_aws_vm_volume_size=20                 # VM root volume in GB
TF_VAR_aws_db_instance_class=db.t3.micro
TF_VAR_aws_db_allocated_storage=20           # RDS storage in GB, each of the three engines
TF_VAR_aws_db_storage_type=gp3               # gp3 | gp2. gp2 drops to 3 IOPS/GB once burst runs out

# --- Bucket -------------------------------------------------------------------
#   An S3 bucket name is globally unique across ALL AWS accounts, so common
#   names are already taken and the apply fails with BucketAlreadyExists.
#   Append a date or your own identifier. Lowercase, digits and hyphens, 3-63 chars.
TF_VAR_aws_bucket_name=ChangeMe

# --- Database name and master account -----------------------------------------
#   PostgreSQL reserves names such as admin and rdsadmin, so they cannot be used
#   as the master account. dbadmin is safe on all three engines.
TF_VAR_aws_db_name=testdb
TF_VAR_aws_db_username=dbadmin

# --- DB engine versions -------------------------------------------------------
#   The versions RDS supports change over time; check with
#     aws rds describe-db-engine-versions --engine <engine> --region <region>
TF_VAR_aws_mysql_version=8.0       # Supported by RDS: 5.7, 8.0, 8.4
TF_VAR_aws_mariadb_version=10.6    # Supported by RDS: 10.5, 10.6, 10.11, 11.4, 11.8  (11.8+ sets require_secure_transport=ON, i.e. TLS required)
TF_VAR_aws_postgres_version=14     # Supported by RDS: 11, 12, 13, 14, 15, 16, 17, 18

# --- Plaintext client connections ---------------------------------------------
#   RDS enforces TLS by default on some engine versions, and a client that
#   insists on plaintext then cannot connect:
#     mysql      never enforced by default
#     mariadb    require_secure_transport=ON from 11.8
#     postgres   rds.force_ssl=1 from 15
#   With the versions above (8.0 / 10.6 / 14) none of the three enforce it.
#
#   csp-default  leave the RDS default alone (default)
#   off          attach a parameter group allowing plaintext
#
#   ⚠ Fixed at creation time. To change it on an already prepared module:
#       ./scripts/teardown.sh aws database
#       ./scripts/prepare.sh     aws database
#     Re-applying with --force would attach the group to running instances and
#     leave postgres waiting for a reboot it never gets.
TF_VAR_aws_secure_transport=csp-default

# --- Filesystem test data path ------------------------------------------------
#   Where gendata writes the filesystem migration data on the VM. It must be
#   writable by the login account: SFTP cannot sudo. Unset picks the OS default:
#   /home/ubuntu/testdata on ubuntu (login ubuntu), C:/testdata on windows
#   (login Administrator; created by the VM's init script).
#TF_VAR_aws_data_path=/home/ubuntu/testdata

# --- VM operating system ------------------------------------------------------
#   ubuntu   Ubuntu 22.04 (default)
#   windows  Windows Server 2022. Logs in over SSH as Administrator with the
#            generated key (OpenSSH Server is installed on first boot), and over
#            RDP with the password: ./scripts/conn-info.sh aws vm --reveal.
#            Needs TF_VAR_aws_vm_volume_size >= 30, cannot use NFS, and wants
#            more than a t3.micro.
#   ⚠ Fixed at creation time: changing it needs ./scripts/prepare.sh aws vm
#     --force, which RE-CREATES the VM.
#TF_VAR_aws_vm_os=ubuntu

# --- Servers installed on the VM ----------------------------------------------
#   Installed natively (no Docker) on either OS, each listening on all interfaces
#   and opened to TF_VAR_allowed_cidr - which is 0.0.0.0/0 unless you narrow it,
#   so set it to your own IP.
#   prepare.sh waits for the install (it runs over SSH once the VM is up) and
#   fails when it fails. Five servers take ~10 min on ubuntu, 15-25 on windows,
#   and need memory: use TF_VAR_aws_instance_type=t3.large (8 GB) or bigger.
#   Changing the list, a version or the account later re-runs the install on the
#   same VM with ./scripts/prepare.sh aws vm --force; the VM is kept. A server
#   taken off the list loses its ports and outputs but stays installed.
#   Fill them with test data: ./scripts/gen-data.sh --source vm --target all
#
#   [] installs nothing. Servers you can list, in any order and any subset:
#     "minio"       MinIO       9000 (console 9001)
#     "mysql"       MySQL       3306
#     "mariadb"     MariaDB     3307
#     "postgresql"  PostgreSQL  5432
#     "mongodb"     MongoDB     27017
#   e.g. all five:
#     TF_VAR_aws_vm_servers='["minio","mysql","mariadb","postgresql","mongodb"]'
TF_VAR_aws_vm_servers='[]'

#   One account on every installed server: a remote user with full rights on
#   mysql/mariadb, a SUPERUSER role on postgresql, a root user in mongodb's admin
#   database, and the MinIO root user.
#TF_VAR_aws_vm_server_username=dbadmin
#TF_VAR_aws_vm_db_name=testdb               # created on mysql, mariadb, postgresql
#TF_VAR_aws_vm_minio_bucket=testbucket

# --- [CREDENTIAL] VM server password ------------------------------------------
#   Stored in OpenBao secret/vm/aws, then blanked here, like the keys above.
#   Change ChangeMe before ./scripts/up.sh: it is refused as a value. Leave it
#   empty if you install no servers on the VM; listing a server needs it set.
#   8+ characters (MinIO's minimum), none of  ' " ` \ $  or whitespace - the
#   install scripts write it into SQL, shell and config files unquoted.
TF_VAR_aws_vm_server_password=ChangeMe

#   Versions - full versions, since they name the download files.
#     mysql, mariadb  official tarball (ubuntu) / ZIP (windows), exactly this version
#     postgres        ubuntu: latest minor of the major from PGDG; windows: this EDB build
#     mongodb         ubuntu: latest of the major.minor series; windows: this MSI
#     minio           GitHub release. The open-source project is archived: this is
#                     the last release with binaries, and it gets no more security fixes.
#TF_VAR_aws_vm_mysql_version=8.4.6
#TF_VAR_aws_vm_mariadb_version=10.11.13
#TF_VAR_aws_vm_postgres_version=14.19
#TF_VAR_aws_vm_mongodb_version=7.0.24
#TF_VAR_aws_vm_minio_release=RELEASE.2025-09-07T16-13-09Z

# --- NFS (EFS) mounted on the VM ----------------------------------------------
#   true creates an EFS file system alongside the VM and mounts it over NFS at
#   TF_VAR_aws_nfs_mount_path. The IAM user then also needs EFS permissions
#   (elasticfilesystem:*).
#
#   The mount path and TF_VAR_aws_data_path above are independent settings that
#   share a default, so with both left alone the test data lands ON the NFS
#   mount. Point one of them elsewhere and the data stays on the local disk
#   while the NFS is mounted on its own.
#
#   The mount path must not be /, /home, /home/ubuntu (it would hide
#   .ssh/authorized_keys and lock SSH out) or a system directory.
#
#   ⚠ Fixed at creation time. Changing either value on a prepared VM needs
#     ./scripts/prepare.sh aws vm --force, which RE-CREATES the VM - data on
#     its local disk is lost. EFS and its data go with ./scripts/teardown.sh aws vm.
TF_VAR_aws_nfs_enabled=false
#TF_VAR_aws_nfs_mount_path=/home/ubuntu/testdata


# ##############################################################################
# ###
# ###   N C P        Object Storage / managed Cloud DB / server (vm)
# ###
# ##############################################################################

# --- [CREDENTIAL] Access key --------------------------------------------------
#   Stored in OpenBao secret/csp/ncp, then blanked here.
#   Issue them at: Portal > My Page > Manage Authentication Key.
#   Object Storage (S3-compatible API) uses this same key pair.
NCP_ACCESS_KEY=ChangeMe
NCP_SECRET_KEY=ChangeMe

# --- [CREDENTIAL] DB master password ------------------------------------------
#   Stored in OpenBao secret/db/ncp, then blanked here.
#   The provider enforces these rules and a violation fails the apply, so
#   register-creds.sh rejects a bad password up front:
#     - 8 to 20 characters
#     - at least one letter, one digit and one special character
#     - allowed special characters: ~ ! @ # $ % ^ * ( ) - _ = [ ] { } ; : , . < > ?
#     - forbidden:  ` & + \ " ' /  and whitespace
#   Example: Cent1pede!2024
NCP_DB_PASSWORD=ChangeMe

# --- Region, zone and naming --------------------------------------------------
#   name_prefix is short for "centipede tofu" - it tags every NCP resource this
#   environment creates so they are easy to tell apart from anything else in the
#   account. It stays short because the managed MongoDB service_name is limited
#   to 15 characters (cptf-mongodb is 12).
#
#   The prefix is also the environment, exactly as TF_VAR_aws_name_prefix above:
#   changing it starts a new one (its own VPC included) next to the old one.
#   ./scripts/list.sh shows every environment. Each needs its own bucket name.
TF_VAR_ncp_region=KR
TF_VAR_ncp_zone=KR-2
TF_VAR_ncp_name_prefix=cptftemp
TF_VAR_ncp_vpc_cidr=10.10.0.0/16

# --- Bucket -------------------------------------------------------------------
#   Unique within the region. Lowercase, digits, dots and hyphens, 3-63 chars.
TF_VAR_ncp_bucket_name=ChangeMe

# --- Server image and spec (used by the VM) -----------------------------------
#   Verify they exist with: ./scripts/ncp-db-versions.sh server
TF_VAR_ncp_server_image_name=ubuntu-22.04-base
TF_VAR_ncp_server_spec_code=s2-g3
#   Boot disk in GB - the VM's only disk, so the filesystem test data has to fit
#   on it (gendata checks). NCP's own default is 10. Fixed at creation: changing
#   it on a prepared VM re-creates the VM.
TF_VAR_ncp_vm_volume_size=50

# --- Database name and master account -----------------------------------------
TF_VAR_ncp_db_name=testdb
TF_VAR_ncp_db_username=dbadmin

# --- DB engine versions -------------------------------------------------------
#   Always use the FULL version string. With a partial version such as 8.0, the
#   provider normalizes state to 8.0.36 and every plan then schedules a DB
#   re-creation that takes about 30 minutes.
#   List the supported versions with: ./scripts/ncp-db-versions.sh
TF_VAR_ncp_mysql_version=8.0.36       # 8.0.36, 8.0.40, 8.0.42, 8.0.45, 8.4.6, 8.4.8
TF_VAR_ncp_postgres_version=14.22     # 13.3, 13.21, 14.13, 14.18, 14.20, 14.22, 15.15, 15.17
TF_VAR_ncp_mongodb_version=7.0.28     # 6.0.27, 7.0.19, 7.0.24, 7.0.28, 8.0.19

# --- DB server specs ----------------------------------------------------------
#   Empty leaves it to NCP's default spec. To choose one, copy a
#   product code (the part before the parenthesis) from
#     ./scripts/ncp-db-versions.sh <mysql|postgresql|mongodb>
#   which lists the specs of the versions set above. Setting or changing it on a
#   prepared DB re-creates that DB (about 30 minutes, data lost).
#   A spec only works with the image it is listed under. MongoDB's storage type
#   follows the spec's generation by itself: SSD for a G2 code (...G002), CB2
#   otherwise.
#TF_VAR_ncp_mysql_product_code=
#TF_VAR_ncp_postgres_product_code=
#TF_VAR_ncp_mongodb_product_code=
#   The image the spec above is listed under - its [image ...] code in the same
#   output. Set it together with the spec: without it NCP picks the image, and a
#   spec of another image is refused. Empty leaves both to NCP.
#TF_VAR_ncp_mysql_image_product_code=
#TF_VAR_ncp_postgres_image_product_code=
#TF_VAR_ncp_mongodb_image_product_code=

# --- Filesystem test data path ------------------------------------------------
#   Where gendata writes the filesystem migration data on the server. It must be
#   writable by the login account: SFTP cannot sudo. NCP images log in as root.
#TF_VAR_ncp_data_path=/root/testdata


# ##############################################################################
# ###
# ###   A L I B A B A   OSS bucket / RDS (mysql, mariadb, postgres) +
# ###                   ApsaraDB for MongoDB / ECS (vm)
# ###
# ##############################################################################

# --- [CREDENTIAL] Access key --------------------------------------------------
#   Stored in OpenBao secret/csp/alibaba, then blanked here.
#   RAM user with OSS, ECS, VPC, RDS and MongoDB (DDS) permissions.
#   OSS (S3-compatible API) uses this same key pair.
#   Not named ALIBABA_CLOUD_ACCESS_KEY_ID / ALICLOUD_ACCESS_KEY on purpose: the
#   alicloud provider reads those from the environment, and .env is the runner's
#   env_file - the keys reach the provider only from OpenBao.
ALIBABA_ACCESS_KEY_ID=ChangeMe
ALIBABA_ACCESS_KEY_SECRET=ChangeMe

# --- [CREDENTIAL] DB master password ------------------------------------------
#   Stored in OpenBao secret/db/alibaba, then blanked here.
#   One password for RDS and MongoDB, which apply the same rule, and
#   register-creds.sh checks it up front:
#     - 8 to 32 characters
#     - at least three of: uppercase, lowercase, digits, special characters
#     - allowed special characters:  ! $ ^ & * ( ) _ + - =
#     - forbidden:  @ # %  (Alibaba accepts them, but they break the MongoDB
#       URI gendata builds) and anything not listed above
#   Quote it in single quotes when it has a special character, since .env is
#   sourced by bash.
#   Example: Cent1pede_2024
ALIBABA_DB_PASSWORD=ChangeMe

# --- Region, zone and naming --------------------------------------------------
#   name_prefix names every Alibaba resource this environment creates, as
#   TF_VAR_aws_name_prefix does. 2-20 lowercase characters.
#
#   The prefix is also the environment: changing it starts a new one (its own
#   VPC included) next to the old one. ./scripts/list.sh shows every
#   environment. Each needs its own bucket name. "default" is reserved.
#
#   ECS, RDS and MongoDB all go in the one vSwitch of TF_VAR_alibaba_zone, so the
#   zone must offer all three: ./scripts/alibaba-db-versions.sh zones
TF_VAR_alibaba_region=ap-northeast-2
TF_VAR_alibaba_zone=ap-northeast-2a
TF_VAR_alibaba_name_prefix=cptftemp
TF_VAR_alibaba_vpc_cidr=10.20.0.0/16

# --- Bucket -------------------------------------------------------------------
#   An OSS bucket name is globally unique across ALL Alibaba Cloud accounts, so
#   append a date or your own identifier. Lowercase, digits and hyphens, 3-63
#   chars. Teardown deletes the objects in it as well (force_destroy).
TF_VAR_alibaba_bucket_name=ChangeMe

# --- ECS instance (used by the VM) --------------------------------------------
#   Verify they exist with: ./scripts/alibaba-db-versions.sh server
#   Alibaba images log in as root, with the generated key.
TF_VAR_alibaba_instance_type=ecs.t6-c1m2.large
#   The image regex picks the MOST RECENT match, so keep it narrow: a bare
#   ^ubuntu_22_04_x64 also matches the 100 GB GPU driver + CUDA image, which a
#   40 GB disk cannot hold. The plan refuses an image larger than the disk.
TF_VAR_alibaba_image_name_regex=^ubuntu_22_04_x64_20G_alibase_
#   System disk in GB (20-500) - the VM's only disk, so the filesystem test data
#   has to fit on it (gendata checks). Fixed at creation: changing it on a
#   prepared VM re-creates the VM.
TF_VAR_alibaba_vm_volume_size=40
TF_VAR_alibaba_vm_disk_category=cloud_essd
#   Public IP bandwidth in Mbps (1-100), billed by traffic. It limits traffic
#   going OUT of the VM; uploads to it are not capped by this value.
TF_VAR_alibaba_vm_bandwidth_out=10

# --- Database name and master account -----------------------------------------
#   RDS only. The username is lowercase letters, digits and underscore, starts
#   with a letter, 16 characters at most.
#   MongoDB replica sets have one fixed account, root, so it is not set here:
#   the database module outputs it as mongodb_username.
TF_VAR_alibaba_db_name=testdb
TF_VAR_alibaba_db_username=dbadmin

# --- RDS sizing (mysql, mariadb, postgresql) ----------------------------------
#   category, per engine: Basic (single node, cheaper) | HighAvailability
#   (standby in the same zone). What is sold differs by engine: MariaDB is
#   HighAvailability only (two nodes, billed accordingly), with HA classes (*.2c).
#   A class is sold only for an engine version, edition, storage type and zone
#   together, and is checked at plan time. List the ones that fit .env with
#     ./scripts/alibaba-db-versions.sh <mysql|mariadb|postgresql>
#   ⚠ Changing a class or the storage on a prepared DB resizes the instance.
TF_VAR_alibaba_mysql_category=Basic
TF_VAR_alibaba_mariadb_category=HighAvailability
TF_VAR_alibaba_postgres_category=Basic
TF_VAR_alibaba_mysql_instance_class=mysql.n2.medium.1
TF_VAR_alibaba_mariadb_instance_class=mariadb.n2.medium.2c
TF_VAR_alibaba_postgres_instance_class=pg.n2.medium.1
TF_VAR_alibaba_db_allocated_storage=20     # RDS storage in GB, each engine, in 5 GB steps
TF_VAR_alibaba_db_storage_type=cloud_essd

# --- MongoDB sizing (replica set) ---------------------------------------------
#   A class is sold for a version, node count, storage type and zone together.
#   List the versions, node counts and classes that fit .env with
#     ./scripts/alibaba-db-versions.sh mongodb
#   (through the Alibaba Cloud CLI in the runner: the provider has no data source
#   for them). In ap-northeast-2a on cloud_essd1, 3, 5 and 7 nodes are sold - not 1.
TF_VAR_alibaba_mongodb_instance_class=mdb.shard.4x.large.d
TF_VAR_alibaba_mongodb_storage=20          # GB, in 10 GB steps
TF_VAR_alibaba_mongodb_storage_type=cloud_essd1
TF_VAR_alibaba_mongodb_replication_factor=3   # replica set nodes: 1, 3, 5 or 7

# --- DB engine versions -------------------------------------------------------
#   The RDS versions each engine supports differ per zone; list them with
#     ./scripts/alibaba-db-versions.sh <mysql|mariadb|postgresql>
#   ⚠ Fixed at creation in practice: a different major version is an upgrade,
#     not a re-create - tear the engine down and prepare it again instead.
TF_VAR_alibaba_mysql_version=8.0
TF_VAR_alibaba_mariadb_version=10.6
TF_VAR_alibaba_postgres_version=14.0
TF_VAR_alibaba_mongodb_version=7.0

# --- Filesystem test data path ------------------------------------------------
#   Where gendata writes the filesystem migration data on the VM. It must be
#   writable by the login account: SFTP cannot sudo. Alibaba images log in as root.
#TF_VAR_alibaba_data_path=/root/testdata


# ##############################################################################
# ###
# ###   A Z U R E     Blob Storage / MySQL + PostgreSQL Flexible Server +
# ###                 Azure DocumentDB (Cosmos DB for MongoDB vCore) / Linux VM
# ###
# ##############################################################################

# --- [CREDENTIAL] Service principal -------------------------------------------
#   Stored in OpenBao secret/csp/azure, then blanked here.
#   Create one with: az ad sp create-for-rbac --role Contributor \
#                      --scopes /subscriptions/<subscription id>
#   It also needs to register resource providers on the subscription
#   (Microsoft.Storage, .Compute, .Network, .DBforMySQL, .DBforPostgreSQL,
#   .DocumentDB) - Contributor includes it - or have them registered beforehand.
#   Not named ARM_* on purpose: azurerm reads those from the environment, and
#   .env is the runner's env_file - the keys reach the provider only from OpenBao.
AZURE_CLIENT_ID=ChangeMe
AZURE_CLIENT_SECRET=ChangeMe
AZURE_TENANT_ID=ChangeMe
AZURE_SUBSCRIPTION_ID=ChangeMe

# --- [CREDENTIAL] Blob Storage access (S3AccessKey / S3SecretKey) --------------
#   Stored in OpenBao secret/csp/azure with the service principal, then blanked.
#   Azure Blob has no S3 API; these follow the cb-tumblebug / cb-spider naming:
#     AZURE_S3_ACCESS_KEY   S3AccessKey = the Storage Account NAME
#     AZURE_S3_SECRET_KEY   S3SecretKey = one of its access keys (base64)
#   The Storage Account must already exist - create it in the portal (Storage
#   accounts > Create, StorageV2) and copy a key from Security + networking >
#   Access keys. tofu/azure/bucket creates only the container in it, and
#   teardown removes only the container: the account and its other containers
#   are left as they are.
#   Registered together with the service principal: re-registering one means
#   filling in all six again.
AZURE_S3_ACCESS_KEY=ChangeMe
AZURE_S3_SECRET_KEY=ChangeMe

# --- [CREDENTIAL] DB admin password -------------------------------------------
#   Stored in OpenBao secret/db/azure, then blanked here.
#   One password for MySQL, PostgreSQL and MongoDB; register-creds.sh checks:
#     - 8 to 128 characters
#     - at least three of: uppercase, lowercase, digits, special characters
#     - allowed special characters:  ! $ ^ & * ( ) _ + - =
#     - forbidden:  @ # % and anything else - they break the connection URIs
#     - must not contain TF_VAR_azure_db_username (Azure refuses it)
#   Quote it in single quotes when it has a special character.
#   Example: Cent1pede_2024
AZURE_DB_PASSWORD=ChangeMe

# --- Region and naming --------------------------------------------------------
#   The region is what Azure calls the location (the `location` argument of
#   every resource); it is named region here like the other CSPs.
#
#   The prefix is the environment, as with the other CSPs. The vm and database
#   modules each get a resource group of their own - <prefix>-vm-rg,
#   <prefix>-database-rg - and teardown deletes it with everything inside.
#   2-12 characters. Names that must be globally unique (DB servers, MongoDB
#   cluster) get a random suffix, so they need no setting here.
TF_VAR_azure_region=koreacentral
TF_VAR_azure_name_prefix=cptftemp

# --- Bucket (Blob container) --------------------------------------------------
#   The container created in the AZURE_S3_ACCESS_KEY storage account. Each
#   environment needs its own name, as on the other CSPs. Lowercase, digits and
#   hyphens, 3-63 chars.
TF_VAR_azure_bucket_name=ChangeMe

# --- VM -----------------------------------------------------------------------
#   Login is azureuser with the generated key (Azure does not allow root).
#   List the sizes with: ./scripts/azure-db-versions.sh server
TF_VAR_azure_vm_size=Standard_B2s
TF_VAR_azure_vm_volume_size=30                     # OS disk in GB, 30 or more; fixed at creation
TF_VAR_azure_vm_disk_type=StandardSSD_LRS          # Standard_LRS | StandardSSD_LRS | Premium_LRS
TF_VAR_azure_vnet_cidr=10.30.0.0/16
#   Ubuntu 22.04 (gen2) from Canonical.
TF_VAR_azure_image_offer=0001-com-ubuntu-server-jammy
TF_VAR_azure_image_sku=22_04-lts-gen2

# --- Database name and admin account ------------------------------------------
#   One admin account on all three. Azure refuses admin, administrator, root,
#   azure_superuser, guest, public and names starting with pg_.
TF_VAR_azure_db_name=testdb                        # created on mysql and postgresql
TF_VAR_azure_db_username=dbadmin

# --- MySQL / PostgreSQL Flexible Server sizing --------------------------------
#   SKU is <tier>_<size>, e.g. B_Standard_B1ms. List them with
#     ./scripts/azure-db-versions.sh <mysql|postgresql>
#   PostgreSQL storage comes in fixed sizes: 32, 64, 128, 256 ... GB.
#   MySQL log_bin_trust_function_creators is ON by default on Azure, so the
#   fixture's functions and triggers load with no parameter set.
TF_VAR_azure_mysql_sku=B_Standard_B2s
TF_VAR_azure_mysql_storage_gb=20                   # 20-16384
TF_VAR_azure_postgres_sku=GP_Standard_D2ds_v5
TF_VAR_azure_postgres_storage_gb=32

# --- MongoDB vCore (Azure DocumentDB) sizing ----------------------------------
#   Tier: Free (one per subscription), M10, M20, ... - the ones azurerm accepts are
#   listed by ./scripts/azure-db-versions.sh mongodb. M10 / M20 / M25 are
#   burstable; a cluster at M30 or above cannot be scaled back down to them.
TF_VAR_azure_mongodb_tier=M30
TF_VAR_azure_mongodb_storage_gb=32
TF_VAR_azure_mongodb_high_availability=Disabled    # Disabled | ZoneRedundantPreferred

# --- DB engine versions -------------------------------------------------------
#   List the versions each engine sells in the region with
#     ./scripts/azure-db-versions.sh
TF_VAR_azure_mysql_version=8.0.21
TF_VAR_azure_postgres_version=14
TF_VAR_azure_mongodb_version=7.0

# --- Filesystem test data path ------------------------------------------------
#   Must be writable by the login account (azureuser): SFTP cannot sudo.
#TF_VAR_azure_data_path=/home/azureuser/testdata


# ##############################################################################
# ###
# ###   G C P       Cloud Storage / Cloud SQL for MySQL + PostgreSQL /
# ###               Compute Engine VM
# ###
# ##############################################################################

# --- [CREDENTIAL] Service account ---------------------------------------------
#   Stored in OpenBao secret/csp/gcp, then blanked here.
#   The five keys are the fields of the same name in a service account's JSON key
#   (IAM & Admin > Service accounts > Keys > Add key > JSON), as cb-tumblebug and
#   cb-spider take them. Print the lines to paste from the downloaded key with
#     jq -r '"GCP_CLIENT_ID=\(.client_id)\nGCP_CLIENT_EMAIL=\(.client_email)\nGCP_PRIVATE_KEY_ID=\(.private_key_id)\nGCP_PRIVATE_KEY='"'"'\(.private_key|@json|.[1:-1])'"'"'\nGCP_PROJECT_ID=\(.project_id)"' key.json
#   GCP_PRIVATE_KEY is one line with literal \n in it. Put it in single quotes:
#   double quotes give the same value to the scripts, but docker compose turns
#   their \n into real newlines in the runner, and with no quotes at all the
#   spaces in "BEGIN PRIVATE KEY" break the line when .env is read.
#   The account needs the Editor role on the project (or Compute Admin, Cloud SQL
#   Admin and Storage Admin).
#   Enable the APIs the modules use on the project beforehand - tofuenv does not:
#     gcloud services enable storage.googleapis.com compute.googleapis.com sqladmin.googleapis.com
#   (or APIs & Services > Enable APIs and services in the console).
#   Not named GOOGLE_* on purpose: the google provider reads those from the
#   environment, and .env is the runner's env_file - the keys reach the provider
#   only from OpenBao.
GCP_CLIENT_ID=ChangeMe
GCP_CLIENT_EMAIL=ChangeMe
GCP_PRIVATE_KEY_ID=ChangeMe
GCP_PRIVATE_KEY=ChangeMe
GCP_PROJECT_ID=ChangeMe

# --- [CREDENTIAL] Cloud Storage interoperability (S3AccessKey / S3SecretKey) ---
#   Stored in OpenBao secret/csp/gcp with the service account, then blanked.
#   The HMAC key the S3-compatible API signs with, cb-tumblebug / cb-spider naming:
#     GCP_S3_ACCESS_KEY   S3AccessKey = the HMAC access ID (GOOG...)
#     GCP_S3_SECRET_KEY   S3SecretKey = its secret
#   Create it beforehand for the service account above (Cloud Storage > Settings
#   > Interoperability > Create a key for a service account); the secret is
#   shown only once. tofuenv does not create or delete HMAC keys.
#   Registered together with the service account: re-registering one means
#   filling in all seven again.
GCP_S3_ACCESS_KEY=ChangeMe
GCP_S3_SECRET_KEY=ChangeMe

# --- [CREDENTIAL] DB admin password -------------------------------------------
#   Stored in OpenBao secret/db/gcp, then blanked here.
#   One password for MySQL and PostgreSQL; register-creds.sh checks:
#     - 8 to 64 characters
#     - at least three of: uppercase, lowercase, digits, special characters
#     - allowed special characters:  ! $ ^ & * ( ) _ + - =
#     - forbidden:  @ # % and anything else - they break the connection URIs
#   Quote it in single quotes when it has a special character.
#   Example: Cent1pede_2024
GCP_DB_PASSWORD=ChangeMe

# --- Region, zone and naming --------------------------------------------------
#   asia-northeast3 is Seoul. The VM is zonal and goes in TF_VAR_gcp_zone, which
#   must be in the region; the bucket and the Cloud SQL instances are regional.
#
#   The prefix is the environment, as with the other CSPs; it starts every
#   resource name. 2-12 characters. Cloud SQL instance names get a random suffix
#   (a deleted name cannot be reused for about a week), so they need no setting.
TF_VAR_gcp_region=asia-northeast3
TF_VAR_gcp_zone=asia-northeast3-a
TF_VAR_gcp_name_prefix=cptftemp

# --- Bucket -------------------------------------------------------------------
#   GCS bucket names are global across all of Google Cloud, like S3 ones: pick
#   one nobody else uses. Lowercase, digits, hyphens, underscores, 3-63 chars.
TF_VAR_gcp_bucket_name=ChangeMe

# --- VM -----------------------------------------------------------------------
#   Login is ubuntu with the generated key, put on the VM through instance
#   metadata. List the machine types with: ./scripts/gcp-db-versions.sh server
TF_VAR_gcp_machine_type=e2-medium
TF_VAR_gcp_vm_volume_size=30                       # boot disk in GB, 10 or more; fixed at creation
TF_VAR_gcp_vm_disk_type=pd-balanced                # pd-standard | pd-balanced | pd-ssd
TF_VAR_gcp_subnet_cidr=10.40.0.0/24                # the subnet of the VPC the vm module creates
#   Ubuntu 22.04 from Canonical's public image project.
TF_VAR_gcp_image_project=ubuntu-os-cloud
TF_VAR_gcp_image_family=ubuntu-2204-lts

# --- Database name and admin account ------------------------------------------
#   One admin account on both. Cloud SQL keeps root (MySQL) and postgres
#   (PostgreSQL) for itself, and the PostgreSQL account gets cloudsqlsuperuser,
#   not SUPERUSER.
TF_VAR_gcp_db_name=testdb
TF_VAR_gcp_db_username=dbadmin

# --- Cloud SQL sizing ---------------------------------------------------------
#   Tier db-custom-<vCPU>-<memory MB>: db-custom-1-3840 is 1 dedicated vCPU /
#   3.75 GB. The shared-core db-g1-small (1.7 GB) costs about half, but has no
#   SLA and its speed varies with the neighbours. List them with
#     ./scripts/gcp-db-versions.sh <mysql|postgresql>
#   Both run the Enterprise edition: Enterprise Plus, the default for MySQL 8.4
#   and PostgreSQL 16+, refuses these small tiers.
#   MySQL log_bin_trust_function_creators is set on by the module, so the
#   fixture's functions and triggers load.
TF_VAR_gcp_mysql_tier=db-custom-1-3840
TF_VAR_gcp_mysql_storage_gb=20                     # 10 or more
TF_VAR_gcp_postgres_tier=db-custom-1-3840
TF_VAR_gcp_postgres_storage_gb=20                  # 10 or more

# --- DB engine versions -------------------------------------------------------
#   The version number alone; the module turns it into the Cloud SQL name
#   (8.4 -> MYSQL_8_4, 16 -> POSTGRES_16). List them with
#     ./scripts/gcp-db-versions.sh
#   A version past its community end of life is in Cloud SQL extended support,
#   which is billed on top.
TF_VAR_gcp_mysql_version=8.4
TF_VAR_gcp_postgres_version=16

# --- Filesystem test data path ------------------------------------------------
#   Must be writable by the login account (ubuntu): SFTP cannot sudo.
#TF_VAR_gcp_data_path=/home/ubuntu/testdata
